     */
    private String getDefaultResponse(String userInput) {
        String[] responses = {
            "Tell me the subject and class/grade, and what you want: a definition, an example, or a step-by-step solution.",
            "What topic is this from (Math/Science/History/etc.) and what level are you studying? I can explain it in a simpler way once I know.",
            "If you paste the exact question from your textbook or assignment, I can help break it down and show the steps.",
            "Try rephrasing like: 'Define ___', 'Explain ___ with an example', or 'How do I solve ___?'."
        };
        return responses[random.nextInt(responses.length)];
    }
    
